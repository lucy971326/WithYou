# WithYou backend configuration

# DashScope API key.
# The key must belong to the selected site; international and domestic keys are not interchangeable.
DASHSCOPE_API_KEY=

# Site selector: intl (international) or cn (mainland China).
QWEN_SITE=intl

# Models and voice
QWEN_PLOT_MODEL=qwen3.8-max
QWEN_REALTIME_MODEL=qwen3.5-omni-plus-realtime
QWEN_REALTIME_VOICE=Tina

# Qwen endpoints: configure both sites, then select one with QWEN_SITE.
QWEN_PLOT_BASE_URL_INTL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_PLOT_BASE_URL_CN=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_REALTIME_URL_INTL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime
QWEN_REALTIME_URL_CN=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_VOICE_API_URL_INTL=https://dashscope-intl.aliyuncs.com/api/v1/services/audio/tts/customization
QWEN_VOICE_API_URL_CN=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/customization

# Server
WITHYOU_ADDR=127.0.0.1:8080
